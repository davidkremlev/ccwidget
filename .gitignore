# macOS
.DS_Store

# Build products
build/
.build/
DerivedData/
*.o
*.dSYM
*.dSYM.zip
*.ipa
*.hmap
*.moved-aside

# The Xcode project is generated from project.yml by XcodeGen, so it is a
# build product like any other. Run `xcodegen generate` after cloning.
*.xcodeproj/

# Points sourcekit-lsp at this machine's DerivedData, so it cannot be shared.
# CONTRIBUTING has the one command that regenerates it.
buildServer.json

# Xcode's per-user state.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Swift Package Manager
.swiftpm/
Package.resolved

# Written beside a baseline when it does not match, so the difference can be
# read rather than reconstructed from an assertion message.
*.actual

# Secrets and local settings
*.local
.env
