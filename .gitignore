# Xcode's per-user state.
# project.pbxproj itself belongs in the repository: without it the project
# builds for nobody. Only what Xcode writes for one particular person is
# excluded.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Swift Package Manager
.swiftpm/
Package.resolved

# Secrets and local settings
*.local
.env
