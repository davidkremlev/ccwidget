    "%lld history points exist; deleting them resets the forecast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt %lld Verlaufspunkte; sie zu löschen setzt die Schätzung zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld puntos de historial; borrarlos reinicia la estimación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴が %lld 点あります。削除すると推定は最初からになります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накоплено %lld точек истории; после удаления оценка начнётся заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 个历史点；删除后估算将重新开始。"
          }
        }
      }
    },
    "A copy is saved as %@ next to it first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuvor wird daneben eine Kopie als %@ abgelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes se guarda una copia como %@ al lado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その前に %@ という名前でコピーを隣に保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед этим рядом сохраняется копия %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前会在旁边保存一份名为 %@ 的副本。"
          }
        }
      }
    },
    "Add the widget to your desktop first, then run setup again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das Widget zuerst zum Schreibtisch hinzu und starten Sie die Einrichtung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade el widget al escritorio y vuelve a ejecutar la configuración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にウィジェットをデスクトップに追加してから、もう一度セットアップしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте виджет на рабочий стол, затем повторите настройку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先把小组件添加到桌面，然后重新运行设置。"
          }
        }
      }
    },
    "Add the widget to your desktop first.": {
