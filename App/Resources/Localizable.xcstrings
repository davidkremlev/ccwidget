    "settings.json had to be rewritten, so key order and indentation changed. The backup has the original.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json musste neu geschrieben werden, Reihenfolge und Einrückung haben sich geändert. Das Original liegt in der Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubo que reescribir settings.json, así que el orden y la sangría cambiaron. El original está en la copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json を書き直したため、キーの順序とインデントが変わりました。元はバックアップにあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json пришлось пересобрать, порядок ключей и отступы изменились. Исходник — в копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json 不得不重建，键顺序和缩进已改变。原文件在备份中。"
          }
        }
      }
    },
    "settings.json is a symlink whose target cannot be written. Setup would replace the link with a regular file.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json ist ein Symlink, dessen Ziel nicht beschreibbar ist. Die Einrichtung würde den Link durch eine normale Datei ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json es un enlace simbólico cuyo destino no se puede escribir. La configuración lo reemplazaría por un archivo normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json はシンボリックリンクですが、リンク先に書き込めません。セットアップはリンクを通常のファイルで置き換えてしまいます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json — символическая ссылка, но её цель недоступна на запись. Установка заменит ссылку обычным файлом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json 是符号链接，但目标不可写。设置会用普通文件替换该链接。"
          }
        }
      }
    },
    "settings.json is a symlink. Setup writes through it, so the link stays intact.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
