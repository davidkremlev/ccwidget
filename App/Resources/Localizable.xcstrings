              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "履歴が %lld 点あります。削除すると推定は最初からになります。"
                }
              }
            }
          }
        },
        "ru": {
