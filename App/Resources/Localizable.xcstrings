    "%lld history points exist; deleting them resets the forecast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Es gibt %lld Verlaufspunkt; ihn zu löschen setzt die Schätzung zurück."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Es gibt %lld Verlaufspunkte; sie zu löschen setzt die Schätzung zurück."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld history point exists; deleting it resets the estimate."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld history points exist; deleting them resets the estimate."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hay %lld punto de historial; borrarlo reinicia la estimación."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hay %lld puntos de historial; borrarlos reinicia la estimación."
