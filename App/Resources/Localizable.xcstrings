    "Add the widget to your desktop first, then run setup again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das Widget zuerst zum Schreibtisch hinzu und starten Sie die Einrichtung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade el widget al escritorio y vuelve a ejecutar la configuración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にウィジェットをデスクトップに追加してから、もう一度セットアップしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте виджет на рабочий стол, затем повторите настройку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先把小组件添加到桌面，然后重新运行设置。"
          }
        }
      }
    },
