            "value": "settings.json ist ein Symlink. Die Einrichtung schreibt hindurch, der Link bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json es un enlace simbólico. La configuración escribe a través de él y el enlace se conserva."
          }
        },
        "ja": {
