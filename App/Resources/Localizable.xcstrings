    "Add the widget to your desktop first. Right-click the desktop, choose Edit Widgets, then come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das Widget zuerst zum Schreibtisch hinzu: Rechtsklick, „Widgets bearbeiten“, dann zurückkommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade el widget al escritorio: clic derecho, Editar widgets, y vuelve aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にウィジェットをデスクトップに追加してください。デスクトップを右クリックし「ウィジェットを編集」を選んでから戻ってください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте виджет на рабочий стол: правый клик по столу, «Изменить виджеты», затем вернитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先把小组件添加到桌面：右键点击桌面，选择“编辑小组件”，然后返回。"
          }
        }
      }
    },
