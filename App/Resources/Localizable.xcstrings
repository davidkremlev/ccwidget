            "value": "設定を %@ としてバックアップしました"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия настроек: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已备份为 %@"
          }
        }
      }
    },
    "Setup will replace it. The backup lets you put it back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung ersetzt sie. Mit der Sicherung können Sie sie zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración la reemplazará. La copia de seguridad permite restaurarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップはそれを置き換えます。バックアップから戻せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка её заменит. Резервная копия позволит вернуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置将替换它。备份可用于还原。"
          }
        }
      }
    },
    "Setup writes the exporter to ~/.claude/ and points the status line at it. Your settings.json is backed up first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung schreibt den Exporter nach ~/.claude/ und richtet die Statuszeile darauf aus. Ihre settings.json wird vorher gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración escribe el exportador en ~/.claude/ y apunta la línea de estado hacia él. Antes se hace una copia de tu settings.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップは ~/.claude/ にエクスポーターを書き込み、ステータスラインをそこに向けます。settings.json は事前にバックアップされます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка положит экспортёр в ~/.claude/ и направит на него статуслайн. Резервная копия settings.json делается заранее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置会把导出器写入 ~/.claude/ 并让状态行指向它。你的 settings.json 会先备份。"
          }
        }
      }
    },
    "Show manual instructions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle Anleitung zeigen"
          }
