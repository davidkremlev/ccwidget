    "Setup writes the exporter to ~/.claude/ and adds one key to settings.json. Only that key changes — your formatting and key order are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung schreibt den Exporter nach ~/.claude/ und fügt settings.json einen Schlüssel hinzu. Nur dieser ändert sich, Formatierung und Reihenfolge bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración escribe el exportador en ~/.claude/ y añade una clave a settings.json. Solo cambia esa clave: tu formato y el orden se conservan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップは ~/.claude/ にエクスポーターを書き、settings.json にキーを一つ加えます。変わるのはそのキーだけで、書式と順序は保たれます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка положит экспортёр в ~/.claude/ и добавит один ключ в settings.json. Меняется только он — форматирование и порядок ключей сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置会把导出器写入 ~/.claude/，并向 settings.json 添加一个键。只有该键会变，你的格式与键顺序保持不变。"
          }
        }
      }
    },
    "Setup writes the exporter to ~/.claude/ and points the status line at it. Your settings.json is backed up first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung schreibt den Exporter nach ~/.claude/ und richtet die Statuszeile darauf aus. Ihre settings.json wird vorher gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración escribe el exportador en ~/.claude/ y apunta la línea de estado hacia él. Antes se hace una copia de tu settings.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップは ~/.claude/ にエクスポーターを書き込み、ステータスラインをそこに向けます。settings.json は事前にバックアップされます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка положит экспортёр в ~/.claude/ и направит на него статуслайн. Резервная копия settings.json делается заранее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置会把导出器写入 ~/.claude/ 并让状态行指向它。你的 settings.json 会先备份。"
          }
        }
      }
    },
