      }
    },
    "The exporter template is missing from the app bundle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Exporter-Vorlage fehlt im App-Bundle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la plantilla del exportador en el paquete de la app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリバンドルにエクスポーターのテンプレートがありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблон экспортёра отсутствует в бандле приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用包中缺少导出器模板。"
          }
        }
      }
    },
    "The status line runs on every redraw, so the first numbers appear within seconds of the model replying.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Statuszeile läuft bei jedem Neuzeichnen, die ersten Zahlen erscheinen also Sekunden nach der Antwort des Modells."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de estado se ejecuta en cada redibujado, así que los primeros números aparecen segundos después de que el modelo responda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスラインは再描画のたびに実行されるため、モデルの応答から数秒で最初の数値が現れます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статуслайн вызывается на каждую перерисовку, поэтому первые цифры появятся через секунды после ответа модели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态行在每次重绘时运行，因此模型回复后几秒内就会出现第一批数字。"
          }
        }
      }
    },
    "The statusLine key is removed from settings.json. Other keys are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel statusLine wird aus settings.json entfernt. Andere Schlüssel bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina la clave statusLine de settings.json. Las demás claves no se tocan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "settings.json から statusLine キーを削除します。他のキーは変更しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из settings.json удаляется ключ statusLine. Остальные ключи не трогаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从 settings.json 中删除 statusLine 键，其他键保持不变。"
          }
        }
      }
    },
    "These have to be removed by hand: %@": {
