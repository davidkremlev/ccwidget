#!/usr/bin/env python3
import json, os, stat, subprocess, sys, time

# The installer performs both substitutions:
#   __GROUP_DIR__  quotes included, as a valid Python literal
#   the first line replaced with an absolute interpreter path
GROUP_DIR = "__GROUP_DIR__"

# The status line that was configured before this one, substituted by the
# installer as a Python literal the same way GROUP_DIR is, or None when there
# was nothing there.
#
# This exists so that installing a widget does not cost somebody their prompt.
# The exporter prints nothing of its own — it writes a file and exits — so
# taking the statusLine key over used to leave the line blank, which for an
# audience running ccstatusline or a script of their own is a bad trade. Now
# the previous command is called with the same input Claude Code sent here,
# and whatever it prints is printed.
#
# It runs through a shell because that is how Claude Code runs it: the status
# line documentation says the command field "runs in a shell", and inline
# `jq` pipelines are its own examples. Running it any other way would break
# exactly the configurations this is meant to preserve. The string is the
# user's own command, unchanged — nothing here composes or quotes it.
CHAINED = __CHAINED__

# How long the chained command may take before it is abandoned. Claude Code
# redraws the status line dozens of times a minute, so a command that hangs
# would hang every one of them; three seconds is long enough for a script that
# shells out to git and short enough that a broken one is a stutter rather
# than a freeze.
CHAIN_TIMEOUT = 3.0

# Anything larger is not our data. The status line sends kilobytes; a megabyte
# is three hundred times the headroom. Without a limit a gigabyte of input
# landed in the snapshot whole and killed the widget extension on read.
MAX_INPUT = 1 << 20

MIN_INTERVAL = 600   # see section 7: history deduplication
MAX_HISTORY = 2000   # section 7: line limit for the history
KEEP_HISTORY = 1000  # how many lines to keep when truncating


def is_regular_or_absent(path):
    """True if the path holds a regular file or nothing at all.

    A symlink does not count as a regular file: writing through one destroys
    whatever is on the other end, and this exporter runs dozens of times a
    minute with the user's privileges.
    """
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return True
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode)


def open_new(path):
    """Opens a file for writing, refusing to follow a symlink."""
    try:
        # unlink removes the link itself, not what it points at.
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError:
        return None
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except OSError:
        return None
    return os.fdopen(fd, "w")


def open_append(path):
    if not is_regular_or_absent(path):
        return None
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    except OSError:
        return None
    return os.fdopen(fd, "a")


def truncate_history(path):
    """Truncation per section 7.

    It lives here rather than in the app: the exporter runs on every redraw,
    while the app window may never be opened at all — and then the limit would
    never be enforced.
    """
    try:
        with open(path, "rb") as f:
            lines = f.read().splitlines()
    except OSError:
        return
    if len(lines) <= MAX_HISTORY:
        return
    tail = lines[-KEEP_HISTORY:]
    tmp = path + ".tmp"
    handle = open_new(tmp)
    if handle is None:
        return
    with handle as f:
        f.write(b"\n".join(tail).decode("utf-8", "replace") + "\n")
    os.replace(tmp, path)


def last_history_entry(path):
    """The last non-empty history line. Read the tail, not the whole file."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 4096))
            lines = f.read().splitlines()
        for raw in reversed(lines):
            if raw.strip():
                return json.loads(raw)
    except Exception:
        pass
    return None


def should_append(prev, entry):
    if prev is None:
        return True
    if prev.get("resetsAt") != entry["resetsAt"]:
        return True
    if prev.get("sevenDay") != entry["sevenDay"]:
        return True
    return entry["t"] - (prev.get("t") or 0) > MIN_INTERVAL


def note_skip(session_id):
    """Records that the exporter is declining to write, keeping the first
    moment. Failures here are ignored: a diagnostic must never be the thing
    that breaks the status line."""
    path = os.path.join(GROUP_DIR, "export-skipped.json")
    if os.path.exists(path):
        return
    payload = {
        "since": int(time.time()),
        "reason": "the status line sent no rate_limits",
        "sessionId": session_id[:8] if isinstance(session_id, str) else None,
    }
    try:
        handle = open_new(path + ".tmp")
        if handle is None:
            return
        with handle as f:
            json.dump(payload, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def note_chain(reason):
    """Records that the chained status line did not work.

    Loud rather than silent, for the reason in section 6.1 — and here the
    symptom is somebody's prompt going blank, which they will blame on this
    widget either way. `ccwidget-dump` prints it. Kept until the chain works
    again, and holding the first moment rather than the last: what matters is
    when it started.
    """
    if not os.path.isdir(GROUP_DIR):
        return
    path = os.path.join(GROUP_DIR, "chain-failed.json")
    if os.path.exists(path):
        return
    payload = {"since": int(time.time()), "reason": reason}
    try:
        handle = open_new(path + ".tmp")
        if handle is None:
            return
        with handle as f:
            json.dump(payload, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def clear_chain_notice():
    try:
        os.unlink(os.path.join(GROUP_DIR, "chain-failed.json"))
    except OSError:
        pass


def run_chained(raw):
    """Runs the status line that was there before this one and prints it.

    Its output goes to stdout unchanged, because that is the whole contract of
    a status line command: Claude Code prints what it prints.
    """
    if not CHAINED:
        return
    try:
        result = subprocess.run(
            CHAINED, shell=True, input=raw,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=CHAIN_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        note_chain("the chained status line did not answer in %g s" % CHAIN_TIMEOUT)
        return
    except Exception as exc:
        note_chain("the chained status line could not be run: %s" % type(exc).__name__)
        return

    if result.stdout:
        try:
            sys.stdout.buffer.write(result.stdout)
            sys.stdout.buffer.flush()
        except Exception:
            pass
    if result.returncode != 0:
        note_chain("the chained status line exited %d" % result.returncode)
    else:
        clear_chain_notice()


def clear_skip():
    try:
        os.unlink(os.path.join(GROUP_DIR, "export-skipped.json"))
    except OSError:
        pass


def main(raw):
    try:
        d = json.loads(raw)
    except Exception:
        return
    if not isinstance(d, dict):
        return

    # The system creates the extension's container the first time the widget
    # runs. Creating it from outside is not allowed: containermanagerd may
    # decide the directory is foreign and relocate it. No parent means the
    # widget has never run.
    if not os.path.isdir(os.path.dirname(GROUP_DIR)):
        return

    os.makedirs(GROUP_DIR, exist_ok=True)

    rl = d.get("rate_limits") or {}
    cw = d.get("context_window") or {}
    cu = cw.get("current_usage") or {}
    ws = d.get("workspace") or {}
    repo = ws.get("repo") or {}
    md = d.get("model") or {}

    read = cu.get("cache_read_input_tokens") or 0
    write = cu.get("cache_creation_input_tokens") or 0
    total = read + write
    ratio = round(read / total, 4) if total else None

    def pct(v):
        """Percentages arrive whole or fractional: 28.000000000000004."""
        try:
            return int(round(float(v)))
        except (TypeError, ValueError):
            return None

    def window(key):
        w = rl.get(key)
        if not w or pct(w.get("used_percentage")) is None:
            return None
        return {
            "usedPercentage": pct(w.get("used_percentage")),
            "resetsAt": w.get("resets_at"),
        }

    five_hour = window("five_hour")
    seven_day = window("seven_day")

    # A session's first redraw carries no rate_limits at all — no key, and a
    # context window whose usage is null. Writing that snapshot replaces the
    # numbers a person is looking at with nothing, which is what emptied the
    # widget on every restart of Claude Code.
    #
    # The payload does not say the limits are zero. It says this redraw knows
    # nothing about them, and that is not news: the snapshot on disk stays, its
    # age goes on growing, and the age is what says how current it is. The
    # first prompt of the session brings real numbers a moment later.
    #
    # Nothing is merged and nothing is preserved by hand — the write is simply
    # skipped. Keeping old numbers under a fresh capturedAt would be the one
    # outcome worse than either.
    #
    # And it is not skipped quietly. A silent fallback turns a defect into an
    # absence of data: on a session start this lasts seconds and explains
    # itself, but if rate_limits ever went missing mid-session and stayed
    # missing, the exporter would fall quiet for good, the snapshot would age,
    # and the symptom would be indistinguishable from Claude Code not running.
    # The notice says since when and why; `ccwidget-dump` prints it.
    #
    # Written on the way into silence and not on every redraw — the status line
    # redraws dozens of times a minute, and what matters is when the silence
    # started, not how many times it has been observed since. Deleted below the
    # moment a snapshot is written again.
    if five_hour is None and seven_day is None:
        note_skip(d.get("session_id"))
        return

    clear_skip()

    # Section 4: write only what is displayed. There is no full project path
    # here — the widget never shows it, and it can name a client.
    session = d.get("session_id")
    session = session[:8] if isinstance(session, str) else None

    snap = {
        "schemaVersion": 1,
        "capturedAt": int(time.time()),
        "sessionId": session,
        "claudeCodeVersion": d.get("version"),
        "model": {
            "id": md.get("id"),
            "displayName": md.get("display_name"),
            "effort": (d.get("effort") or {}).get("level"),
        },
        "project": {
            "name": repo.get("name")
            or os.path.basename(ws.get("current_dir") or ""),
        },
        "limits": {
            "fiveHour": five_hour,
            "sevenDay": seven_day,
        },
        "context": {
            "usedPercentage": pct(cw.get("used_percentage")),
            "totalInputTokens": cw.get("total_input_tokens"),
            "windowSize": cw.get("context_window_size"),
            "cacheHitRatio": ratio,
        },
        "cost": {"sessionUsd": (d.get("cost") or {}).get("total_cost_usd")},
    }

    tmp = os.path.join(GROUP_DIR, "snapshot.json.tmp")
    handle = open_new(tmp)
    if handle is None:
        return
    with handle as f:
        json.dump(snap, f, ensure_ascii=False)
    target = os.path.join(GROUP_DIR, "snapshot.json")
    # os.replace renames the link itself rather than following it.
    os.replace(tmp, target)

    sd = snap["limits"]["sevenDay"]
    if sd:
        hist = os.path.join(GROUP_DIR, "history.jsonl")
        entry = {
            "t": snap["capturedAt"],
            "sevenDay": sd["usedPercentage"],
            "resetsAt": sd.get("resetsAt"),
        }
        if should_append(last_history_entry(hist), entry):
            handle = open_append(hist)
            if handle is None:
                return
            with handle as f:
                f.write(json.dumps(entry) + "\n")
            truncate_history(hist)


# Our own work first, then theirs, and the order is deliberate.
#
# Writing the snapshot takes about twenty milliseconds and cannot fail in a way
# that blocks; the chained command is somebody else's program and might hang
# for the whole timeout. If it went first, a broken status line would stop the
# widget getting data as well — one defect becoming two. This way the widget
# keeps working even while the chained line is broken, and the prompt is late
# by twenty milliseconds, which nobody can see.
INPUT = b""
try:
    INPUT = sys.stdin.buffer.read(MAX_INPUT + 1)
except Exception:
    pass

if len(INPUT) <= MAX_INPUT:
    try:
        main(INPUT)
    except Exception:
        pass

try:
    run_chained(INPUT)
except Exception:
    pass
