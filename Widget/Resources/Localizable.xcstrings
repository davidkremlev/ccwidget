    "Claude Code sends them to Pro and Max accounts, after the first reply.": {
      "comment": "The rule, quoted so the reader can draw their own conclusion",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code sendet sie an Pro- und Max-Konten, nach der ersten Antwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code los envía a las cuentas Pro y Max, tras la primera respuesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code は Pro と Max のアカウントに、最初の応答のあとで送信します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code присылает их аккаунтам Pro и Max после первого ответа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 会在首次回复之后，向 Pro 和 Max 账户发送。"
          }
        }
      }
    },
