    "Subscription limits, context window and cost at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abo-Limits, Kontextfenster und Kosten auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites de suscripción, ventana de contexto y coste de un vistazo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションの上限、コンテキストウィンドウ、コストをひと目で。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимиты подписки, окно контекста и стоимость — одним взглядом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅限额、上下文窗口与费用一目了然。"
          }
        }
