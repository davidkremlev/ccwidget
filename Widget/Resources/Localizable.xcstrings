{
  "sourceLanguage": "en",
  "strings": {
    "%@ %%/h": {
      "comment": "Usage rate: a number followed by percent per hour",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %%/Std."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %%/h"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %%/時"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %%/ч"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %%/小时"
          }
        }
      }
    },
